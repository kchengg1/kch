# Alpaca keys: https://app.alpaca.markets → Paper account → API keys
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Claude API key: https://platform.claude.com
ANTHROPIC_API_KEY=

# paper (default) | live. Live also needs TRADER_CONFIRM_LIVE=yes.
TRADER_MODE=paper
# TRADER_CONFIRM_LIVE=yes

# TRADER_MODEL=claude-opus-5
# TRADER_EFFORT=high
# TRADER_SCHEDULE=09:45,12:30,15:30
# TRADER_GOAL=Grow the account from about $1,000 toward $100,000.

# Hard risk limits (defaults shown)
# RISK_MAX_POSITION_PCT=0.4
# RISK_MAX_OPEN_POSITIONS=4
# RISK_MAX_ORDERS_PER_DAY=4
# RISK_MIN_EQUITY_TO_OPEN=150
# RISK_MAX_SLIPPAGE_PCT=0.05
# RISK_MIN_OPTION_DTE=2
# RISK_MAX_DAY_TRADES=3
