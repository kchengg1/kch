{
  "name": "@kch/perks-ios",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "build": "expo export --platform ios --output-dir dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eas:init": "npx --yes eas-cli@latest init",
    "eas:credentials": "npx --yes eas-cli@latest credentials --platform ios",
    "build:preview": "EAS_BUILD_NO_EXPO_GO_WARNING=true npx --yes eas-cli@latest build --platform ios --profile preview",
    "build:testflight": "EAS_BUILD_NO_EXPO_GO_WARNING=true npx --yes eas-cli@latest build --platform ios --profile production --auto-submit",
    "update:production": "EAS_BUILD_NO_EXPO_GO_WARNING=true npx --yes eas-cli@latest update --channel production"
  },
  "dependencies": {
    "expo": "~58.0.25",
    "expo-clipboard": "~58.0.4",
    "expo-haptics": "~58.0.8",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@kch/perks-types": "workspace:*",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
