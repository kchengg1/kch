  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
