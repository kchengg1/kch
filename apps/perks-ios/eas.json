{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.14.0",
      "pnpm": "10.33.0",
      "env": {
        "EAS_FALLBACK_PACKAGE_MANAGER": "pnpm"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "channel": "development"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "env": {
        "EAS_FALLBACK_PACKAGE_MANAGER": "pnpm",
        "EXPO_PUBLIC_API_URL": "https://kch-six.vercel.app"
      }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "environment": "production",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EAS_FALLBACK_PACKAGE_MANAGER": "pnpm",
        "EXPO_PUBLIC_API_URL": "https://kch-six.vercel.app"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6835674414"
      }
    }
  }
}
