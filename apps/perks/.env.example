# ---- Required ----
# Postgres connection string (Neon, Supabase, Railway, local docker...).
DATABASE_URL=postgres://user:password@localhost:5432/app
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# Public URL of this app (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# ---- Recommended ----
# Comma-separated addresses allowed to create an account. Leave blank to let
# anyone sign up; set it to your own email once the app is on the internet.
ALLOWED_EMAILS=
# Time zone used to decide what "today" is when credits reset.
PERKS_TIMEZONE=America/New_York

# ---- Email digest ----
# Transactional email via Resend (emails print to the server log when blank).
RESEND_API_KEY=
EMAIL_FROM="Perks <hello@example.com>"
# Shared secret for /api/cron/digest. Vercel Cron sends it automatically when
# a CRON_SECRET environment variable exists. openssl rand -hex 32
CRON_SECRET=

# ---- Optional ----
# Google sign-in (leave blank to hide the button).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# PostHog product analytics (disabled when blank).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
