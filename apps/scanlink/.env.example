# ---- Required ----
# Postgres connection string (Neon, Supabase, Railway, local docker...).
DATABASE_URL=postgres://user:password@localhost:5432/app
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# Public URL of this app (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# ---- Stripe (needed for /pricing checkout + /dashboard/billing) ----
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` or the dashboard.
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ids referenced by app.config.ts
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=price_...
NEXT_PUBLIC_STRIPE_PRICE_LIFETIME=price_...

# ---- Optional ----
# Google sign-in (leave blank to hide the button).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Transactional email via Resend (emails print to console when blank).
RESEND_API_KEY=
EMAIL_FROM="My App <hello@example.com>"
# PostHog product analytics (disabled when blank).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
